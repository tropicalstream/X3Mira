<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The page agent listens only while the wearer holds it open with a tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- TextToSpeech engine lookup on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:label="X3Mira"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <!-- Required for the RayNeo Mercury launcher to LIST the app at all.
             Without it the activity is a perfectly valid Android launcher
             entry that simply never appears in the glasses' app drawer, which
             is exactly how this app ended up adb-only. -->
        <meta-data
            android:name="com.rayneo.mercury.app"
            android:value="true" />

        <!-- No ar_mode meta-data on purpose: it restricts rendering to the
             left lens, and this app draws its own side-by-side pair. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- SPLIT filters, not one combined filter: the combined form was
                 never proven to launch on this device (TapBubbles addendum),
                 while MAIN+LAUNCHER and MAIN+AR_APP as separate blocks are. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.rayneo.intent.category.AR_APP" />
            </intent-filter>
        </activity>
        <!--
            Agent key over adb, same two doors as the phone side: push a key
            file into the app's external files dir, or send the SET_API_KEY
            broadcast with a "key" string extra. See ApiKeyStore.
        -->
        <receiver
            android:name=".ApiKeyBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.x3mira.app.SET_API_KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
